# ========================================
# WAFFLEFINANCE ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to `.env` (in the same directory) and fill in real values.
# All secret keys MUST be replaced before running the project.

NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# ========================================
# NETWORK CONFIGURATION
# ========================================

# Primary network mode (testnet or mainnet). All chain selection is derived
# from this single value; testnet uses Sepolia + Stellar testnet, mainnet
# uses Ethereum mainnet + Stellar public network.
NETWORK_MODE=testnet

# Canonical Ethereum ↔ Stellar ↔ Solana asset mappings live in @wafflefinance/sdk
# (packages/sdk/src/assets/index.ts). Extend there for custom testnet pairs.

# RPC URLs — Infura (recommended for production)
# -----------------------------------------------
# Option A (simplest): one key for backend + local dev
#   INFURA_API_KEY=your_project_key
#
# Option B: full URLs (override the key — e.g. different Infura projects)
#   SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_project_key
#   MAINNET_RPC_URL=https://mainnet.infura.io/v3/your_project_key
#
# Resolution order (testnet): SEPOLIA_RPC_URL → ETHEREUM_RPC_URL → Infura → public fallback
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
INFURA_API_KEY=                   # Secret — restrict by HTTP referrer or IP in the Infura dashboard

# Stellar Horizon endpoint (auto-selected if blank).
STELLAR_HORIZON_URL=

# Optional: Soroban RPC endpoint (required once Soroban contracts are deployed).
SOROBAN_RPC_URL=

# Solana RPC endpoint. Defaults to devnet (testnet) or mainnet-beta (mainnet) if blank.
# Consumed by: coordinator, relayer.
SOLANA_RPC_URL=

# ========================================
# CONTRACT ADDRESSES (auto-populated after deploy)
# ========================================

# EVM contracts (filled by deploy scripts).
# These are public on-chain addresses — not secrets.
ETH_HTLC_ESCROW_TESTNET=          # Sepolia testnet only
ETH_HTLC_ESCROW_MAINNET=          # Ethereum mainnet
ETH_RESOLVER_REGISTRY_TESTNET=    # Sepolia testnet only
ETH_RESOLVER_REGISTRY_MAINNET=    # Ethereum mainnet

# Soroban contract IDs (filled by deploy scripts).
# These are public on-chain identifiers — not secrets.
SOROBAN_HTLC_TESTNET=             # Stellar testnet (SDF) only
SOROBAN_HTLC_MAINNET=             # Stellar public network
SOROBAN_RESOLVER_REGISTRY_TESTNET=
SOROBAN_RESOLVER_REGISTRY_MAINNET=

# Solana program IDs (filled by deploy scripts).
# These are public on-chain identifiers — not secrets.
SOLANA_HTLC_PROGRAM_TESTNET=      # Solana devnet only
SOLANA_HTLC_PROGRAM_MAINNET=      # Solana mainnet-beta

# Optional 1inch Escrow Factory fallback (mainnet only).
ONEINCH_ESCROW_FACTORY_MAINNET=0xa7bcb4eac8964306f9e3764f67db6a7af6ddf99a

# ========================================
# COORDINATOR CONFIGURATION
# ========================================
# The coordinator NEVER holds user funds. The keys below are only used for
# (a) submitting non-custodial secret-reveal transactions on the user's
# behalf as a convenience and (b) running an optional reference resolver.
# Users can always claim/refund directly from their own wallet.

# Coordinator database URL.
# Default: file:./wafflefinance.db (SQLite, local development)
# Production: postgresql://user:password@host:5432/wafflefinance (PostgreSQL)
# The schema is automatically applied on startup.
DATABASE_URL=file:./wafflefinance.db

COORDINATOR_PORT=3001
COORDINATOR_POLL_INTERVAL_MS=15000

# CORS origin for coordinator HTTP responses. Defaults to * (open).
# In production, set to the exact frontend origin (e.g. https://app.wafflefinance.io).
# Consumed by: coordinator.
CORS_ORIGIN=*

# Secret key used to encrypt swap preimages at rest in the coordinator database.
# Generate with: openssl rand -hex 32 (produces a 64-character hex string).
# Secret — never share or commit; if rotated, previously encrypted rows become unreadable.
# Optional: if blank, preimages are stored unencrypted (acceptable for local dev only).
# Consumed by: coordinator.
SECRET_STORAGE_KEY=

# Comma-separated list of bearer tokens authorized for privileged operator endpoints.
# Gates POST /api/orders/:id/src-locked, POST /api/orders/:id/dst-locked, and GET /metrics.
# Secret — generate each token with: openssl rand -hex 32
# Must be kept distinct from COORDINATOR_API_KEYS.
# Consumed by: coordinator.
COORDINATOR_OPERATOR_KEYS=

# Comma-separated bearer tokens that grant trusted resolvers elevated rate limits on /api/*.
# Secret — generate each token with: openssl rand -hex 32
# Must be kept distinct from COORDINATOR_OPERATOR_KEYS.
# Consumed by: coordinator.
COORDINATOR_API_KEYS=

# Comma-separated list of trusted reverse-proxy IP addresses.
# When set, the coordinator trusts X-Forwarded-For from these IPs for rate limiting.
# Leave blank if coordinator is exposed directly (no proxy). Optional.
# Consumed by: coordinator.
COORDINATOR_TRUSTED_PROXIES=

# Redis URL for multi-instance SSE broadcast (optional).
# When blank, SSE events are broadcast in-process (single-instance mode only).
# Required for horizontal scaling. Format: redis://host:6379
# Consumed by: coordinator.
REDIS_URL=

# ========================================
# RELAYER CONFIGURATION
# ========================================
# Bearer token / API key that gates all /api/admin/* and /api/debug/* endpoints.
# Generate with: openssl rand -hex 32
# Secret — if blank, ALL admin and debug requests are rejected with 401.
# Supply as: Authorization: Bearer <token>  or  X-Api-Key: <token>
# Consumed by: relayer.
RELAYER_ADMIN_API_KEY=

# Private key used by POST /api/admin/authorize-relayer to sign the on-chain
# authorizeResolver() transaction. Secret — NEVER send over the network; read from
# server environment only. Format: 0x-prefixed 64-character hex Ethereum private key.
# Consumed by: relayer.
RELAYER_ADMIN_PRIVATE_KEY=

# Base URL of the coordinator service. Required for the relayer to announce orders.
# Local dev default matches COORDINATOR_PORT above.
# Consumed by: relayer.
COORDINATOR_URL=http://localhost:3001

# Ethereum private key used by the relayer to sign secret-reveal transactions.
# Secret — never share or commit. Format: 0x-prefixed 64-character hex string.
# Consumed by: relayer.
RELAYER_PRIVATE_KEY=

# Stellar keypair used by the relayer to sign Stellar secret-reveal transactions.
# Secret — RELAYER_STELLAR_SECRET is the signing key; keep it out of version control.
# RELAYER_STELLAR_PUBLIC is the corresponding public key (G... address) — not a secret.
# Consumed by: relayer.
RELAYER_STELLAR_SECRET=
RELAYER_STELLAR_PUBLIC=

# Solana private key for the relayer (base58-encoded keypair or uint8 JSON array).
# Secret — used to sign Solana secret-reveal transactions. Keep out of version control.
# Consumed by: relayer.
SOLANA_PRIVATE_KEY=

# Solana transaction commitment level. One of: processed, confirmed, finalized.
# Defaults to confirmed. Optional.
# Consumed by: coordinator, relayer.
SOLANA_COMMITMENT=confirmed

# Relayer chain polling (DigitalOcean / background listeners).
# Chain monitoring + Infura RPC start on the FIRST swap order only — not at boot,
# not when someone merely opens the site (/api/wake).
# Frontend POST /api/wake → session hint only (zero RPC).
RELAYER_ACTIVE_POLL_INTERVAL_MS=15000
RELAYER_IDLE_POLL_INTERVAL_MS=120000
RELAYER_VISITOR_TTL_MS=300000

# ========================================
# RESOLVER CONFIGURATION
# ========================================
# Only required if this node also acts as a reference resolver.
# Leave blank if running coordinator-only mode.

# Ethereum private key for the resolver to sign authorizeResolver() on-chain calls.
# Secret — format: 0x-prefixed 64-character hex string.
# Consumed by: resolver.
RESOLVER_ETH_PRIVATE_KEY=

# Stellar secret key for the resolver. Secret — S... (56-character base32).
# Consumed by: resolver.
RESOLVER_STELLAR_SECRET=

# Resolver RPC retry configuration (for transient network errors).
RESOLVER_RPC_MAX_RETRIES=5
RESOLVER_RPC_BASE_DELAY_MS=1000
RESOLVER_RPC_MAX_DELAY_MS=30000
RESOLVER_RPC_TIMEOUT_MS=10000

# ========================================
# FEATURE FLAGS
# ========================================
# Runtime feature flags shared across coordinator, relayer, and resolver.
# Set to true to enable; false (or absent) to disable.

# Run Solana interactions in simulation mode (no on-chain transactions). Devnet/testnet only.
FEATURE_SOLANA_SIMULATION_MODE=false
# Enable early Soroban contract support (pre-production; may change without notice).
FEATURE_SOROBAN_EARLY_SUPPORT=false
# Enable experimental UI routes served by the coordinator. Not for production use.
FEATURE_EXPERIMENTAL_UI_ROUTES=false

# ========================================
# 1INCH FUSION+ INTEGRATION (optional)
# ========================================

ONEINCH_API_KEY=                  # Secret — restrict by IP in the 1inch dashboard

# ========================================
# THIRD-PARTY API KEYS
# ========================================
# INFURA_API_KEY is also read for EVM RPC (see NETWORK CONFIGURATION above).

ALCHEMY_API_KEY=                  # Secret — optional, alternative EVM RPC provider
ETHERSCAN_API_KEY=                # Secret — optional, used for contract verification

# ========================================
# FRONTEND (VITE_) CONFIGURATION
# ========================================

VITE_API_BASE_URL=http://localhost:3001
# Production API (DigitalOcean): https://oversync-k36vx.ondigitalocean.app — proxied via vercel.json /api/*
VITE_NETWORK_MODE=testnet
# Set to true to re-enable mainnet toggle (v2 mainnet post-audit)
VITE_MAINNET_ENABLED=false
# Frontend wallet RPC (Vercel). Use full URL or the same Infura key.
# Restrict the key by HTTP referrer in the Infura dashboard.
VITE_SEPOLIA_RPC_URL=
VITE_MAINNET_RPC_URL=
VITE_INFURA_API_KEY=              # Secret — public-facing key; restrict by HTTP referrer in Infura dashboard
VITE_ONEINCH_API_KEY=             # Secret — restrict by HTTP referrer in the 1inch dashboard
